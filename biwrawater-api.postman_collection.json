            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/deliveries/{uuid}/unload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "deliveries", "{uuid}", "unload"]
            },
            "description": "Mulai penurunan (OnTheWay → Unloading)."
          },
          "response": []
        },
        {
          "name": "Photos",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/deliveries/{uuid}/photos",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "deliveries", "{uuid}", "photos"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "filling",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "description": "Upload foto bukti. `type`: `filling` (saat Filling), `completion_tank` / `completion_person` (saat Unloading). Maks 4MB. Pilih file via tab Body → form-data."
          },
          "response": []
        },
        {
          "name": "Deliver",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/deliveries/{uuid}/deliver",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "deliveries", "{uuid}", "deliver"]
            },
            "description": "Selesaikan. Wajib ada foto `completion_tank` + `completion_person`."
          },
          "response": []
        },
        {
          "name": "Fail",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/deliveries/{uuid}/fail",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "deliveries", "{uuid}", "fail"]
            },
            "description": "Gagalkan delivery yang berjalan."
          },
          "response": []
        }
      ]
