            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/deliveries",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "deliveries"]
            },
            "description": "Jadwal delivery driver (aktif FIFO + history)."
          },
          "response": []
