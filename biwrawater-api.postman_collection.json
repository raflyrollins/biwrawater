{
  "info": {
    "name": "Biwrawater API",
    "description": "API mobile Biwrawater (biwtermobile). Prefix `/api/v1`. Auth via Sanctum Bearer token. Set `base_url` environment variable (default `http://127.0.0.1:8000`). Login stores token automatically into `token` variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Pelanggan\",\n  \"email\": \"budi@biwrawater.id\",\n  \"phone\": \"081234567890\",\n  \"password\": \"rahasia123\",\n  \"password_confirmation\": \"rahasia123\"\n}"
            },
            "description": "Registrasi akun customer. `password` min 8 karakter, wajib `password_confirmation`."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.environment.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@biwrawater.id\",\n  \"password\": \"rahasia123\"\n}"
            },
            "description": "Login customer/driver. Response berisi `token` + `user`. Token disimpan otomatis ke variable `token`."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me"]
            },
            "description": "Profil user terautentikasi."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Cabut token aktif."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Katalog (Publik)",
      "item": [
        {
          "name": "Services",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/services",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "services"]
            }
          },
          "response": []
        },
        {
          "name": "Promotions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/promotions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "promotions"]
            }
          },
          "response": []
        },
        {
          "name": "Config (Jam Operasional)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/config",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "config"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Zona & Area (Publik)",
      "item": [
        {
          "name": "Zones",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/zones",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "zones"]
            }
          },
          "response": []
        },
        {
          "name": "Zones Lookup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/zones/lookup",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "zones", "lookup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kecamatan\": \"Medan Marelan\",\n  \"kelurahan\": \"Terjun\"\n}"
            },
            "description": "Cari zona by kecamatan + kelurahan (exact/case-sensitive)."
          },
          "response": []
        },
        {
          "name": "Areas Search",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/areas/search?q=Marelan",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "areas", "search"],
              "query": [
                { "key": "q", "value": "Marelan" }
              ]
            },
            "description": "Pencarian area (full-text). Query opsional: `city`, `kecamatan`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Alamat (Auth)",
      "item": [
