            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/addresses",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "addresses"]
            }
          },
          "response": []
        },
        {
          "name": "Store",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/addresses",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "addresses"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Rumah\",\n  \"recipient_name\": \"Budi\",\n  \"phone\": \"081234567890\",\n  \"street_address\": \"Jl. Terjun No. 12\",\n  \"district\": \"Medan Marelan\",\n  \"subdistrict\": \"Terjun\",\n  \"city\": \"Medan\",\n  \"postal_code\": \"20255\",\n  \"is_default\": true\n}"
            }
          },
          "response": []
        },
        {
          "name": "Update",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/addresses/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "addresses", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Rumah\",\n  \"recipient_name\": \"Budi\",\n  \"phone\": \"081234567890\",\n  \"street_address\": \"Jl. Terjun No. 12\",\n  \"district\": \"Medan Marelan\",\n  \"subdistrict\": \"Terjun\",\n  \"city\": \"Medan\",\n  \"postal_code\": \"20255\",\n  \"is_default\": true\n}"
            },
            "description": "Path `{address}` dibind ke ID numerik (bukan UUID)."
          },
          "response": []
        },
        {
          "name": "Destroy",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/addresses/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "addresses", "1"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Checkout (Auth)",
      "item": [
        {
          "name": "Validate Promo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/checkout/validate-promo",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "checkout", "validate-promo"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"promo_code\": \"HEMAT10\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Checkout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/checkout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "checkout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"address_id\": 1,\n  \"customer_note\": \"Kirim siang\"\n}"
            },
            "description": "Buat pesanan. EITHER `address_id` (alamat tersimpan) ATAU data alamat baru + `zone_id`. `service_id` = 1 (5.000L), 2 (8.000L), 3 (11.000L)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pesanan & Pembayaran (Auth)",
      "item": [
        {
          "name": "Orders",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "response": []
        },
        {
          "name": "Order Detail",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
