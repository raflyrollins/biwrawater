            "description": "Path `{order}` dibind ke UUID. Ganti `{uuid}` dengan nilai nyata."
          },
          "response": []
        },
        {
          "name": "Cancel",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{uuid}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{uuid}", "cancel"]
            },
            "description": "Hanya pesanan `pending` yang bisa dibatalkan."
          },
          "response": []
        },
        {
          "name": "Pay (Midtrans Snap)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{uuid}/pay",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{uuid}", "pay"]
            },
            "description": "Minta token Snap. Butuh pesanan status `confirmed` + belum lunas. Catatan: `.env` MIDTRANS masih dikomentari — perlu konfigurasi key dulu agar berhasil."
          },
          "response": []
        },
        {
          "name": "Payment Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{uuid}/pay-status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{uuid}", "pay-status"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Driver (Auth)",
      "item": [
        {
          "name": "Deliveries",
