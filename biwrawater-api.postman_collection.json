              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"available\"\n}"
            },
            "description": "Ubah status `available` / `off_duty`."
          },
          "response": []
        },
        {
          "name": "Fill",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/deliveries/{uuid}/fill",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "deliveries", "{uuid}", "fill"]
            },
            "description": "Mulai pengisian (Scheduled → Filling). Butuh delivery milik driver & FIFO."
          },
          "response": []
        },
        {
          "name": "Depart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/driver/deliveries/{uuid}/depart",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "driver", "deliveries", "{uuid}", "depart"]
            },
            "description": "Berangkat (Filling → OnTheWay)."
          },
          "response": []
        },
        {
          "name": "Unload",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
