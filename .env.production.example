# =============================================================================
#  Biwrawater — Konfigurasi PRODUCTION
#  Salin ke VPS sebagai `.env`, lalu isi nilai yang benar.
#   cp .env.production.example .env
#  File ini TIDAK memuat secret asli — semua nilai krusial berupa placeholder.
#  Setelah mengisi, jalankan:
#    php artisan key:generate
#    php artisan migrate --force
# =============================================================================

APP_NAME="biwrawater"
# Ubah ke 'production'
APP_ENV=production
# WAJIB: generate di VPS dengan `php artisan key:generate`
APP_KEY=
# WAJIB false di production (jangan pernah tampilkan stack trace / debug di publik)
APP_DEBUG=false
# Ganti dengan IP VPS (tanpa trailing slash): http://203.0.113.10
APP_URL=http://YOUR_SERVER_IP

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Di production boleh 'error' agar tidak membanjiri log
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Midtrans (sandbox/production) — isi dari dashboard Midtrans kamu
#  MIDTRANS_IS_PRODUCTION=true saat beralih ke mode produksi nyata
# -----------------------------------------------------------------------------
MIDTRANS_IS_PRODUCTION=false
ID_MERCHANT=M316290998
CLIENT_KEY=Mid-client-XXXX
SERVER_KEY=Mid-server-XXXX
# Batas waktu bayar setelah konfirmasi admin (menit)
MIDTRANS_PAYMENT_TIMEOUT=20

# -----------------------------------------------------------------------------
# Database PostgreSQL
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=biwrawater
DB_USERNAME=biwrawater
# Ganti dengan password db yang kuat
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# -----------------------------------------------------------------------------
# Session & cache (database — tidak butuh Redis bila pakai setup ini)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Kosongkan bila akses via IP; isi domain bila sudah punya domain
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Broadcasting — Reverb (real-time, dipakai dashboard/driver)
#  Di VPS, REVERB_HOST = IP VPS. Jalankan worker reverb terpisah (lihat deploy notes).
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME_REVERB_APP_ID
REVERB_APP_KEY=CHANGE_ME_REVERB_APP_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_APP_SECRET
REVERB_HOST=YOUR_SERVER_IP
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# Email — ganti dari `log` ke smtp saat sudah siap mengirim email nyata
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@biwrawater.id"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Opsional — bila pakai object storage AWS S3
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
